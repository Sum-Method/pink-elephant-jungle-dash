{
  "name": "pink-elephant-jungle-dash",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run check:css && tsc -p tsconfig.json --noEmit",
    "test": "npm run check && node scripts/run-self-tests.mjs",
    "lint": "npm run check",
    "build:pages": "vite build --outDir docs && node scripts/ensure-pages-nojekyll.mjs",
    "check:css": "node scripts/check-css-braces.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.184.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
